# ==========================================
# PY-NES Custom Rules
# ==========================================

# Runtime files (created when playing)
settings.json
*.sav
*.state
crash.log
py-nes.log

# Game folders (keep repo clean)
covers/
snapshots/

# ROMs (Never upload copyrighted games!)
*.nes
*.NES

# NOTE: Removed *.spec from standard ignore list so main.spec gets uploaded!


# ==========================================
# Standard Python / OS / IDE rules
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller (Manifest only, keeping .spec)
*.manifest

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE settings
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Logs and databases
*.log
db.sqlite3
